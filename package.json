{
  "name": "grabcode",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "stack": "docker compose up -d --wait && pnpm --filter @grabcode/core-api db:migrate && pnpm dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "generate": "pnpm --filter @grabcode/contracts run generate"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
