{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "payout.requested"
    },
    "occurred_at": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "payoutId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "coderUserId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "amountVnd": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "payoutId",
        "coderUserId",
        "amountVnd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "type",
    "occurred_at",
    "data"
  ],
  "additionalProperties": false
}
