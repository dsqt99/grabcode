{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "brief.failed"
    },
    "occurred_at": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "error": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "jobId",
        "error",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "type",
    "occurred_at",
    "data"
  ],
  "additionalProperties": false
}
