{
  "name": "@grabcode/core-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx --test src/orders/transition.test.ts src/payments/ledger.test.ts src/realtime/token.test.ts src/auth/password.test.ts src/repos/repos.test.ts src/admin/admin.service.test.ts src/dispatch/approval.test.ts src/orders/customer-flow.test.ts src/orders/orders.service.test.ts src/auth/dev-login-guard.test.ts",
    "smoke:dispatch": "node scripts/smoke-dispatch.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs"
  },
  "dependencies": {
    "@grabcode/contracts": "workspace:*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "nats": "^2.29.0",
    "postgres": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.7",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
