# Copy to .env at the repo root. Backend services load it via `node --env-file-if-exists=../../.env`.
DATABASE_URL=postgres://grabcode:grabcode@127.0.0.1:5433/grabcode
NATS_URL=nats://127.0.0.1:4223
CORE_API_PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost:3001

# brief-worker: any OpenAI-compatible chat completions endpoint (vLLM here).
LLM_BASE_URL=https://vllm.anm05.com/v1
LLM_API_KEY=
LLM_MODEL=qwen-3.6-35b-a3b

# apps/web: set to enable the real backend; unset = local mock brief generator.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth (core-api). GitHub OAuth App callback: {API_PUBLIC_URL}/v1/auth/github/callback
API_PUBLIC_URL=http://localhost:4000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client (Web), redirect URI: {API_PUBLIC_URL}/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub App for per-order private repos (repo-worker). Permissions: Administration RW, Contents RW,
# Metadata R; Subscribe to events: Push (tick it, else no commits arrive) -> <public URL>/v1/github/webhook.
# Local: webhook URL = a smee.io channel, then `npx smee-client --url <smee> --target http://localhost:4000/v1/github/webhook`.
# Keep API_PUBLIC_URL = localhost (OAuth callbacks); the smee URL goes only in the GitHub App settings.
GITHUB_ORG=grabcode-sandbox
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM with literal \n line breaks, or set GITHUB_APP_PRIVATE_KEY_PATH to the downloaded .pem (absolute path: workers run from their own folder).
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
# Dev-only login without GitHub (ignored when NODE_ENV=production)
AUTH_DEV_LOGIN=true

# Bank account that receives customer payments, shown with a VietQR code (img.vietqr.io).
# PAYMENT_BANK_ID = VietQR bank code or BIN (MB / 970422, VCB / 970436, TCB / 970407...). Empty = "not configured" on the payment page.
# An admin confirms each transfer in /admin (Orders -> "Xác nhận đã nhận tiền"). Older SEPAY_BANK/SEPAY_ACCOUNT_* names still work.
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
# Optional SePay webhook for automatic confirmation: URL {API_PUBLIC_URL}/v1/payments/sepay/webhook, auth "API Key".
SEPAY_WEBHOOK_API_KEY=

# QA Gate (qa-worker): each step runs in a throwaway Docker container with this image.
QA_IMAGE=node:22-alpine
QA_STEP_TIMEOUT_MS=600000
# Local tests only: clone ${GIT_CLONE_BASE}/<owner>/<repo>.git instead of GitHub (e.g. file:///D:/repos).
GIT_CLONE_BASE=
# Sandbox preview (deploy-worker): needs gcloud CLI on PATH, `gcloud auth login`, Cloud Run + Cloud Build enabled.
GCP_PROJECT=
GCP_REGION=asia-southeast1
# Runtime identity of sandboxes: a service account with NO roles (coder code runs there). Required by deploy-worker.
SANDBOX_SERVICE_ACCOUNT=
SANDBOX_TTL_HOURS=72
# Paid orders no coder accepted are cancelled + refunded after this many hours (0 = admin refunds by hand)
AUTO_REFUND_HOURS=24
# Delivered orders the customer left alone this many hours are accepted by the system and the coder is paid (0 = off)
AUTO_ACCEPT_HOURS=72
# Behind a proxy/LB: hops to trust for X-Forwarded-For (1 on Cloud Run). Empty = direct connections only
TRUST_PROXY=

# S6 realtime (Centrifugo, docker compose). Same secret for core-api (signs tokens) and centrifugo (verifies).
# Empty = realtime off: GET /v1/realtime/token returns 404 and apps keep polling.
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=
REALTIME_WS_URL=ws://localhost:8000/connection/websocket

# WebPush (notifier sends, core-api serves the public key at GET /v1/push/key). Generate: npx web-push generate-vapid-keys
# Empty = push off: the /profile button hides and notifier acks events without sending.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Admin notices (notifier -> Telegram bot: new order, "Tôi đã chuyển khoản", dispute, payout request). See docs/DEPLOY.md 3.8.
# Empty = notices are only printed in the notifier log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ADMIN_PUBLIC_URL=http://localhost:3002/admin
