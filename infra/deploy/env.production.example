# Copy to .env.production at the repo root ON THE SERVER, fill in, never commit (gitignored).
#   cp infra/deploy/env.production.example .env.production && nano .env.production
# Empty values = feature off. Required: DOMAIN, POSTGRES_PASSWORD, WEB_ORIGIN, API_PUBLIC_URL, PAYMENT_*, SUPPORT_ZALO or SUPPORT_HOTLINE.

# ---- Domain (DNS A record -> the VPS IP). Same value, with https://, in the three URLs below. ----
DOMAIN=
WEB_ORIGIN=
API_PUBLIC_URL=
# Caddy is the only proxy in front of core-api.
TRUST_PROXY=1

# ---- Database: long random letters/digits only (it goes into a URL). openssl rand -hex 24 ----
POSTGRES_PASSWORD=

# ---- Bank account that receives customer payments (shown with a VietQR code) ----
# PAYMENT_BANK_ID: VietQR bank code or BIN, e.g. MB / 970422, VCB / 970436, TCB / 970407, ACB / 970416.
PAYMENT_BANK_ID=
# Name shown to the customer, e.g. "MB Bank".
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
# Account holder name in capitals without diacritics, exactly as the bank shows it, e.g. NGUYEN VAN A.
PAYMENT_ACCOUNT_NAME=

# ---- Customer support shown on the payment page, order page and footer. At least one is required (web build fails). ----
# Zalo number (digits) -> https://zalo.me/<number>; hotline -> tel: link.
SUPPORT_ZALO=
SUPPORT_HOTLINE=

# ---- Optional: automatic payment confirmation through SePay (otherwise an admin confirms in /admin) ----
SEPAY_WEBHOOK_API_KEY=

# ---- Optional: AI brief (any OpenAI-compatible endpoint). Empty key = template brief. ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Optional: Google / GitHub sign-in (email + password works without them) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Optional: web push (docker compose ... --profile push). npx web-push generate-vapid-keys ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Paid orders nobody takes are cancelled + refunded after this many hours (0 = admin decides).
AUTO_REFUND_HOURS=24
# Never true in production (core-api also ignores it when NODE_ENV=production).
AUTH_DEV_LOGIN=false
