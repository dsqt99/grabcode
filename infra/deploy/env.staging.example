# Staging server (docs/STAGING.md). staging-up.sh creates .env.staging from this file and fills the secrets for you:
#   ./infra/deploy/staging-up.sh staging.example.com
# .env.staging stays on the server (gitignored + dockerignored). Never commit it. Empty values = feature off.

# ---- Marks this server as staging. Production must NEVER have these lines. ----
APP_ENV=staging
AUTH_DEV_LOGIN=true
# dev-login needs this key in header x-dev-login-key (staging-up.sh generates it). Smoke/E2E: DEV_LOGIN_KEY=<this value>.
STAGING_DEV_LOGIN_KEY=
# Password of the seeded demo accounts (staging-up.sh generates it).
DEMO_PASSWORD=

# ---- Domain (DNS A record -> the VPS IP). `localhost` works for a dry run on your own machine. ----
DOMAIN=
WEB_ORIGIN=
API_PUBLIC_URL=
TRUST_PROXY=1

POSTGRES_PASSWORD=

# ---- Placeholder bank account: staging must NOT show a real account. The QR still renders. ----
PAYMENT_BANK_ID=MB
PAYMENT_BANK_NAME=MB Bank (STAGING DEMO)
PAYMENT_ACCOUNT_NUMBER=0000000000
PAYMENT_ACCOUNT_NAME=STAGING DEMO
SUPPORT_ZALO=0900000000
SUPPORT_HOTLINE=

# ---- Optional ----
SEPAY_WEBHOOK_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Telegram bot for admin notices (docs/STAGING.md section 5). Empty = notices only in `logs notifier`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ADMIN_PUBLIC_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Staging keeps paid-but-untaken demo orders: do not auto-cancel them while the CEO looks around.
AUTO_REFUND_HOURS=0

# Shared VPS mode (staging-up.sh --port N): written by the script. TRUST_PROXY=2 there (operator proxy + Caddy).
# STAGING_HTTP_PORT=18080
# STAGING_BIND=127.0.0.1
# STAGING_TRUSTED_PROXIES=private_ranges
